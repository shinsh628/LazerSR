<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="HarmonyX" Version="2.16.1" />
  </ItemGroup>
  <ItemGroup>
    <None Include="MinaCalc.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Dan badge artwork (mania-hub public/images/dans). Loaded by path from
         <hookdir>/dans/ — see Drawables/DanImages.cs. -->
    <None Include="Assets\dans\**\*">
      <Link>dans\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LazerSR.SunnyCalculator\LazerSR.SunnyCalculator.csproj" />
    <ProjectReference Include="..\LazerSR.DanCalculator\LazerSR.DanCalculator.csproj" />
    <ProjectReference Include="..\..\osu\osu.Game\osu.Game.csproj" Private="false" ReferenceOutputAssembly="true" />
    <ProjectReference Include="..\..\osu\osu.Game.Rulesets.Mania\osu.Game.Rulesets.Mania.csproj" Private="false" ReferenceOutputAssembly="true" />
  </ItemGroup>
</Project>
