<Window x:Class="LazerSR.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LazerSR"
        Height="200"
        Width="440"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="PillToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track"
                                    CornerRadius="11"
                                    Background="#555"
                                    Width="44" Height="22"/>
                            <Ellipse x:Name="Thumb"
                                     Width="18" Height="18"
                                     Fill="White"
                                     HorizontalAlignment="Left"
                                     Margin="2,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#3A8"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="24,0,0,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <!-- Title -->
        <TextBlock Text="LazerSR"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,12"/>

        <!-- osu! path + Browse -->
        <DockPanel Margin="0,0,0,6">
            <Button DockPanel.Dock="Right"
                    Content="Browse"
                    Width="72"
                    Margin="6,0,0,0"
                    Click="BrowseButton_Click"/>
            <TextBox x:Name="InstallPathTextBox"
                     VerticalContentAlignment="Center"/>
        </DockPanel>

        <!-- Launch + PID/status -->
        <DockPanel Margin="0,0,0,4">
            <Button DockPanel.Dock="Left"
                    Content="Launch osu!"
                    Width="110"
                    Margin="0,0,8,0"
                    Click="LaunchButton_Click"/>
            <TextBlock x:Name="PipeStatusTextBlock"
                       VerticalAlignment="Center"
                       Text="Disconnected"/>
        </DockPanel>

        <TextBlock x:Name="StatusTextBlock"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   Foreground="#AAA"
                   FontSize="11"/>

        <!-- TEMP: sunny+ kill switch, remove once the everyone-diff is trusted -->
        <CheckBox x:Name="SunnyPlusCheckBox"
                  Content="sunny+ 사용"
                  IsChecked="True"
                  Margin="0,0,0,4"
                  Checked="SunnyPlusCheckBox_Toggled"
                  Unchecked="SunnyPlusCheckBox_Toggled"/>

    </StackPanel>
</Window>
